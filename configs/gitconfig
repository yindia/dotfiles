[include]
	path = local/user
	path = local/stuff
[pull]
	rebase = true
[push]
	default = current
	followTags = true
	autoSetupRemote = true
[branch]
	autoSetupRebase = always
	sort = -committerdate
[tag]
	sort = version:refname
[merge]
	ff = only
	conflictStyle = zdiff3
[fetch]
	prune = true
	pruneTags = true
	all = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[alias]
	lg = log --graph --pretty=fuller --decorate --color --show-signature
	ls = log --oneline --abbrev-commit --color
	df = diff --color
	de = diff --color
	amend = commit --amend
	hdiff = -c core.pager=\"hunk pager\" diff
	hshow = -c core.pager=\"hunk pager\" show
[credential]
	helper = osxkeychain
[diff]
	algorithm = histogram
	ignoreSubmodules = dirty
	submodule = log
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = hunk
[core]
	excludesFile = ~/.config/git/ignore
	autocrlf = input
	whitespace = cr-at-eol
	untrackedCache = true
	pager = hunk pager
	editor = nvim
[pager]
	diff = git-diff-pager
	df = diff-so-fancy | less --quit-if-one-screen --pattern '^(Date|added|deleted|modified): '
	de = delta
[submodule]
	fetchJobs = 0
	recurse = true
[help]
	autoCorrect = 5
[status]
	submoduleSummary = true
[column]
	ui = auto
[delta]
	navigate = true
	hyperlinks = true
	dark = true
	line-numbers = true
	syntax-theme = Solarized (dark)

# vi: ft=gitconfig
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[difftool]
	prompt = false

# Per-profile identity. These must stay at the very bottom: git applies
# includes in file order, so anything read later overrides the default
# identity pulled in by `[include] path = local/user` at the top.
#
# Matching is on the remote URL rather than the directory, because
# workspace/tqindia holds at least one repo with a personal remote. Both URL
# forms are listed since a single repo may be cloned over SSH or HTTPS.
#
# Caveat: a freshly `git init`ed repo has no remote yet, so it gets the
# default identity until `git remote add` runs. Re-check with:
#     git config --show-origin user.email
# The SSH key pins live in the profiles, never in local/user: that file is the
# fallback for every other remote, including a third GitHub account and hosts
# that authenticate with an entirely different key. IdentitiesOnly there would
# stop those keys from being offered at all.
[includeIf "hasconfig:remote.*.url:git@github.com:tqindia/**"]
	path = local/user-tqindia
[includeIf "hasconfig:remote.*.url:https://github.com/tqindia/**"]
	path = local/user-tqindia
[includeIf "hasconfig:remote.*.url:git@github.com:yindia/**"]
	path = local/user-yindia
[includeIf "hasconfig:remote.*.url:https://github.com/yindia/**"]
	path = local/user-yindia
