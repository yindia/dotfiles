[include]
	path = local/user
	path = local/stuff
[pull]
	rebase = true
[push]
	default = current
	followTags = true
	autoSetupRemote = true
[branch]
	autoSetupRebase = always
	sort = -committerdate
[tag]
	sort = version:refname
[merge]
	ff = only
	conflictStyle = zdiff3
[fetch]
	prune = true
	pruneTags = true
	all = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[alias]
	lg = log --graph --pretty=fuller --decorate --color --show-signature
	ls = log --oneline --abbrev-commit --color
	df = diff --color
	de = diff --color
	amend = commit --amend
	hdiff = -c core.pager=\"hunk pager\" diff
	hshow = -c core.pager=\"hunk pager\" show
[credential]
	helper = osxkeychain
[diff]
	algorithm = histogram
	ignoreSubmodules = dirty
	submodule = log
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = hunk
[core]
	excludesFile = ~/.config/git/ignore
	autocrlf = input
	whitespace = cr-at-eol
	untrackedCache = true
	pager = hunk pager
	editor = nvim
[pager]
	diff = git-diff-pager
	df = diff-so-fancy | less --quit-if-one-screen --pattern '^(Date|added|deleted|modified): '
	de = delta
[submodule]
	fetchJobs = 0
	recurse = true
[help]
	autoCorrect = 5
[status]
	submoduleSummary = true
[column]
	ui = auto
[delta]
	navigate = true
	hyperlinks = true
	dark = true
	line-numbers = true
	syntax-theme = Solarized (dark)

